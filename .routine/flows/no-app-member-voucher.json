{
  "section": "merchants/members",
  "account": "stamp",
  "viewport": { "width": 1440, "height": 1150 },
  "defaultWaitMs": 3000,
  "steps": [
    {
      "name": "no-app-redemption-notice",
      "goto": "/redemptions",
      "waitMs": 7000,
      "actions": [
        { "click": "button:has-text('Decline')" },
        { "wait": 800 },
        { "click": "button:text-is('Enter Code')" },
        { "wait": 1200 },
        { "fill": ["input[placeholder=\"e.g. 48271593\"]", "28480388"] },
        { "click": "button:text-is('Look Up')" },
        { "wait": 5000 }
      ],
      "clipTo": "div.min-w-0.space-y-2",
      "clipPadding": 12,
      "annotate": [
        { "type": "box", "target": "div[class*=\"border-amber-200\"]", "number": 1, "color": "plum" },
        { "type": "box", "target": "button:has-text('Confirm Redemption')", "number": 2, "color": "plum" }
      ]
    }
  ]
}
