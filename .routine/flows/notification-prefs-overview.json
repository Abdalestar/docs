{
  "deployUrl": "https://dashboard.qtap.qa",
  "section": "settings",
  "account": "points",
  "viewport": { "width": 1440, "height": 1200 },
  "defaultWaitMs": 9000,
  "steps": [
    {
      "name": "settings-notifications-overview",
      "goto": "/settings/notifications",
      "actions": [
        { "wait": 3000 },
        { "click": "button:has-text('Decline')" },
        { "wait": 1200 }
      ],
      "waitFor": "div.rounded-xl:has-text('Marketing emails')",
      "waitMs": 9000,
      "clip": { "x": 260, "y": 60, "width": 1180, "height": 1010 },
      "annotate": [
        { "type": "box", "target": ":nth-match(div.rounded-xl, 1)", "number": 1, "color": "plum" },
        { "type": "box", "target": "div.rounded-xl:has-text('Marketing emails')", "number": 2, "color": "gold" },
        { "type": "box", "target": ":nth-match(div.rounded-xl, 3)", "number": 3, "color": "plum" }
      ]
    }
  ]
}
