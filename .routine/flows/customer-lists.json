{
  "section": "merchants/analytics",
  "account": "stamp",
  "viewport": {
    "width": 1440,
    "height": 2300
  },
  "defaultWaitMs": 3000,
  "steps": [
    {
      "name": "customer-lists-both",
      "goto": "/analytics",
      "actions": [
        {
          "click": "button:has-text('Decline')"
        },
        {
          "wait": 13000
        },
        {
          "hover": "div.rounded-xl:has-text('Best Customers')"
        }
      ],
      "waitFor": "div.rounded-xl:has-text('Best Customers')",
      "waitMs": 3000,
      "clipTo": "div.grid:has(div.rounded-xl:has-text('Churn Risk'))",
      "clipPadding": 12,
      "annotate": [
        {
          "type": "box",
          "target": "div.rounded-xl:has-text('Churn Risk')",
          "number": 1,
          "color": "plum"
        },
        {
          "type": "box",
          "target": "div.rounded-xl:has-text('Best Customers')",
          "number": 2,
          "color": "charcoal"
        },
        {
          "type": "redact",
          "target": "div.rounded-xl:has-text('Churn Risk') p.truncate >> nth=0"
        },
        {
          "type": "redact",
          "target": "div.rounded-xl:has-text('Churn Risk') p.truncate >> nth=1"
        },
        {
          "type": "redact",
          "target": "div.rounded-xl:has-text('Churn Risk') p.truncate >> nth=2"
