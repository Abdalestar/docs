        },
        {
          "type": "redact",
          "target": "div.rounded-xl:has-text('Best Customers') p.truncate >> nth=1"
        },
        {
          "type": "redact",
          "target": "div.rounded-xl:has-text('Best Customers') p.truncate >> nth=2"
        },
        {
          "type": "redact",
          "target": "div.rounded-xl:has-text('Best Customers') p.truncate >> nth=3"
        },
        {
          "type": "redact",
          "target": "div.rounded-xl:has-text('Best Customers') p.truncate >> nth=4"
        },
        {
          "type": "redact",
          "target": "div.rounded-xl:has-text('Best Customers') p.truncate >> nth=5"
        },
        {
          "type": "redact",
          "target": "div.rounded-xl:has-text('Best Customers') li span[class*=\"h-9\"] >> nth=0"
        },
        {
          "type": "redact",
          "target": "div.rounded-xl:has-text('Best Customers') li span[class*=\"h-9\"] >> nth=1"
        },
        {
          "type": "redact",
          "target": "div.rounded-xl:has-text('Best Customers') li span[class*=\"h-9\"] >> nth=2"
        },
        {
          "type": "redact",
          "target": "div.rounded-xl:has-text('Best Customers') li span[class*=\"h-9\"] >> nth=3"
        },
        {
          "type": "redact",
          "target": "div.rounded-xl:has-text('Best Customers') li span[class*=\"h-9\"] >> nth=4"
        },
        {
          "type": "redact",
          "target": "div.rounded-xl:has-text('Best Customers') li span[class*=\"h-9\"] >> nth=5"
        }
      ]
    },
    {
      "name": "customer-lists-churn",
      "goto": "/analytics",
      "actions": [
        {
          "wait": 13000
        },
        {
          "hover": "div.rounded-xl:has-text('Churn Risk')"
        }
      ],
      "waitFor": "div.rounded-xl:has-text('Churn Risk')",
      "waitMs": 2500,
      "clipTo": "div.rounded-xl:has-text('Churn Risk')",
