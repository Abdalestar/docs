{
  "deployUrl": "https://dashboard.qtap.qa",
  "section": "merchants/redemptions",
  "account": "stamp",
  "defaultWaitMs": 3000,
  "viewport": { "width": 1440, "height": 1700 },
  "steps": [
    {
      "name": "reward-types-06-member-vouchers",
      "goto": "/redemptions",
      "waitFor": "text=Enter Redemption Code",
      "actions": [
        { "wait": 4000 },
        { "click": "button:has-text('Decline')" },
        { "wait": 1500 },
        { "click": "button:text-is('Look Up Customer')" },
        { "wait": 1500 },
        { "fill": ["input[placeholder*='Search by name']", "Q102812"] },
        { "wait": 3500 },
        { "click": ".divide-y button" },
        { "wait": 6000 }
      ],
      "clip": { "x": 290, "y": 600, "width": 1120, "height": 900 },
      "annotate": [
        { "type": "box", "target": ":nth-match(div.rounded-lg.border.bg-muted\\/40, 1)", "number": 1, "color": "plum" },
        { "type": "box", "target": ":nth-match(div.rounded-lg.border.bg-muted\\/40, 2)", "number": 2, "color": "plum" }
      ]
    },
    {
      "name": "reward-types-07-confirm",
      "actions": [
        { "click": "button:has-text('Confirm Redemption')" },
        { "wait": 3000 }
      ],
      "waitFor": "[role=dialog]",
      "clipTo": "[role=dialog]",
      "clipPadding": 10,
      "annotate": [
        { "type": "box", "target": "[role=dialog] div.rounded-lg.border.bg-muted\\/40", "color": "plum" }
      ]
    }
  ]
}
