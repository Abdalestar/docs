{
  "section": "merchants/redemptions",
  "account": "points",
  "viewport": { "width": 1440, "height": 1180 },
  "fakeCamera": { "qr": "QTAP-TT026", "aim": "locked" },
  "defaultWaitMs": 2500,
  "steps": [
    {
      "name": "scan-redeem-05-points-rewards",
      "goto": "/redemptions",
      "waitFor": "button:has-text('Scan')",
      "waitMs": 5500,
      "actions": [
        { "click": "button:has-text('Decline')" },
        { "wait": 600 },
        { "click": "button:has-text('Scan')" },
        { "wait": 6000 },
        { "click": ".divide-y button" },
        { "wait": 4500 }
      ],
      "annotate": [
        { "type": "box", "target": "p:has-text('Current Points Balance')", "number": 1, "color": "plum" },
        { "type": "box", "target": "role=button[name=\"Redeem\"]", "number": 2, "color": "gold" },
        { "type": "caption", "text": "On a points program the same scan shows the balance and every reward it already covers." }
      ]
    },
    {
      "name": "scan-redeem-06-points-confirm",
      "actions": [{ "click": "role=button[name=\"Redeem\"]" }, { "wait": 4500 }],
      "clipTo": "[role=dialog]",
      "clipPadding": 10,
      "annotate": [
        { "type": "box", "target": "[role=dialog] p:has-text('Points Cost')", "color": "plum" }
      ]
    }
  ]
}
