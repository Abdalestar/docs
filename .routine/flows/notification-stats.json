{
  "section": "merchants/notifications",
  "account": "points",
  "defaultWaitMs": 4000,
  "viewport": { "width": 1440, "height": 1000 },
  "steps": [
    {
      "name": "notification-stats-list",
      "goto": "/notifications",
      "actions": [
        { "wait": 3000 },
        { "click": "button:has-text(\"Decline\")" },
        { "wait": 1000 }
      ],
      "waitFor": "[role=tablist]",
      "waitMs": 9000,
      "annotate": [
        { "type": "box", "target": "[role=tab]:has-text(\"Sent\")", "number": 1, "color": "plum" },
        { "type": "box", "target": "div.rounded-xl:has(h3:has-text(\"Reward redeemed\"))", "number": 2, "color": "plum" },
        { "type": "caption", "text": "Push Notifications: the Sent tab (1) counts everything that has gone out. Qtap's own automatic messages (2) appear in the same list with their own figures." }
      ]
    },
    {
      "name": "notification-stats-card",
      "goto": "/notifications",
      "waitFor": "[role=tablist]",
      "waitMs": 9000,
      "actions": [
        { "hover": "h3:has-text(\"Reward redeemed\")" },
        { "wait": 800 }
      ],
      "clipTo": "div.rounded-xl:has(h3:has-text(\"Reward redeemed\"))",
      "clipPadding": 14,
      "annotate": [
        { "type": "box", "target": "span:has-text(\"Sent:\")", "color": "plum" },
        { "type": "box", "target": "span:has-text(\"Delivered:\")", "color": "plum" },
        { "type": "box", "target": "span:has-text(\"Opened:\")", "color": "plum" },
        { "type": "box", "target": "span:has-text(\"Clicked:\")", "color": "plum" }
      ]
    },
    {
      "name": "notification-stats-not-pushed",
      "goto": "/notifications",
      "waitFor": "[role=tablist]",
      "waitMs": 9000,
      "actions": [
        { "hover": "[role=tablist]" },
        { "wait": 600 }
      ],
      "clipTo": "div.rounded-xl:has(h3)",
      "clipPadding": 14,
      "annotate": [
        { "type": "box", "target": "text=\"Not pushed\"", "number": 1, "color": "plum" }
      ]
    },
    {
      "name": "notification-stats-zero-delivered",
      "goto": "/notifications",
      "waitFor": "[role=tablist]",
      "waitMs": 9000,
      "actions": [
        { "hover": "h3:has-text(\"Test notification\")" },
        { "wait": 900 }
      ],
      "clipTo": "div.rounded-xl:has(h3:has-text(\"Test notification\"))",
      "clipPadding": 14,
      "annotate": [
        { "type": "box", "target": "div.rounded-xl:has(h3:has-text(\"Test notification\")) span:has-text(\"Delivered:\")", "number": 1, "color": "plum" }
      ]
    }
  ]
}
