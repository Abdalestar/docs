{
  "deployUrl": "https://dashboard.qtap.qa",
  "section": "merchants/redemptions",
  "account": "stamp",
  "defaultWaitMs": 3000,
  "viewport": { "width": 1440, "height": 1200 },
  "steps": [
    {
      "name": "reward-types-01-milestone",
      "goto": "/redemptions",
      "waitFor": "text=Enter Redemption Code",
      "actions": [
        { "wait": 4000 },
        { "click": "button:has-text('Decline')" },
        { "wait": 1500 },
        { "fill": ["input[placeholder*='e.g.']", "24083777"] },
        { "click": "button:text-is('Look Up')" },
        { "wait": 5000 }
      ],
      "clipTo": "div.rounded-lg.border.bg-muted\\/40",
      "clipPadding": 26,
      "annotate": [
        { "type": "box", "target": "div.rounded-lg.border.bg-muted\\/40", "color": "plum" }
      ]
    },
    {
      "name": "reward-types-02-discount",
