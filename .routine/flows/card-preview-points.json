{
  "section": "merchants/redemptions",
  "account": "points",
  "viewport": { "width": 1440, "height": 1200 },
  "defaultWaitMs": 2500,
  "steps": [
    {
      "name": "card-preview-04-points",
      "goto": "/points-operations",
      "actions": [
        { "wait": 3000 },
        { "click": "button:has-text('Decline')" },
        { "wait": 4000 },
        { "fill": ["input[placeholder=\"Search members...\"]", "Q056329"] },
        { "wait": 3500 },
        { "click": ".divide-y button" },
        { "wait": 4000 }
      ],
      "waitMs": 2000,
      "clipTo": "div.space-y-2:has(> div.max-w-\\[366px\\])",
      "clipPadding": 30,
      "annotate": [
        { "type": "redact", "target": "div.space-y-2:has(> div.max-w-\\[366px\\]) span[class*=\"truncate\"]", "color": "charcoal" },
        { "type": "box", "target": "div.space-y-2:has(> div.max-w-\\[366px\\]) p[class*=\"leading-4\"]", "number": 1, "color": "plum" },
        { "type": "box", "target": "button:text-is('Change')", "number": 2, "color": "plum" }
      ]
    },
    {
      "name": "card-preview-05-all-earned",
      "actions": [
        { "click": "button:text-is('Change')" },
        { "wait": 2500 },
        { "fill": ["input[placeholder=\"Search members...\"]", "QTAP-TT026"] },
        { "wait": 3500 },
        { "click": ".divide-y button" },
        { "wait": 4000 }
      ],
      "waitMs": 2000,
      "clipTo": "div.space-y-2:has(> div.max-w-\\[366px\\])",
      "clipPadding": 30,
      "annotate": [
        { "type": "redact", "target": "div.space-y-2:has(> div.max-w-\\[366px\\]) span[class*=\"truncate\"]", "color": "charcoal" },
        { "type": "box", "target": "div.space-y-2:has(> div.max-w-\\[366px\\]) p[class*=\"leading-4\"]", "color": "plum" }
      ]
    }
  ]
}
